# Copy to .env and fill in.
# NOTE: With Prisma 7 the datasource URL lives in prisma7.config.ts
# (currently "file:./dev.db"). For Postgres, change the datasource.url there
# (e.g. to env("DATABASE_URL")) and set the provider in prisma/schema.prisma
# to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
SESSION_SECRET=""
